<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Home</title>
</head>

<body>
  <%- include("partials/navbar") %>
  <div class="content">
    <div class="messages">
      <% messages.forEach((message) => { %>
      <div class="message">
        <div class="message__heading">
          <p class="message__user"><%- message.user %></p>
          <p><%- getTimeSince(message.added) %></p>
        </div>
        <div class="message__text">
          <p><%- message.text %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</body>

</html>