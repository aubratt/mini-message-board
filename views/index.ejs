<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0&icon_names=open_in_new" />
  <title>Home</title>
</head>

<body>
  <%- include("partials/navbar") %>
  <div class="content">
    <div class="messages">
      <% messages.slice().reverse().forEach((message) => { %>
      <div class="message">
        <div class="message__heading">
          <p class="message__user"><%- message.name %></p>
          <p><%- getTimeSince(message.added) %></p>
        </div>
        <div class="message__text">
          <p><%- message.message %></p>
          <a href="/message/<%- message.id %>">
            <span class="material-symbols-outlined">open_in_new</span>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</body>

</html>